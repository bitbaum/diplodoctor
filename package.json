{
  "name": "diplodoctor",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "role:grant": "node scripts/grant-role.mjs",
    "check:analyze": "vitest run --config vitest.live.config.mts live/analyze.live.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.12",
    "@bitbaum/accountkit": "^0.9.1",
    "@bitbaum/ai-kit": "^1.21.4",
    "@bitbaum/chatkit": "^0.21.1",
    "@bitbaum/design-tokens": "^1.2.0",
    "@bitbaum/mail-kit": "^0.2.0",
    "@bitbaum/searchkit": "^0.2.3",
    "@bitbaum/whenkit": "^0.3.3",
    "better-auth": "^1.7.12",
    "bip-kit": "^0.6.1",
    "drizzle-orm": "^0.45.4",
    "limitkit": "^0.2.1",
    "listkit": "npm:@bitbaum/listkit@^0.2.2",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.0",
    "playwright": "^1.64.1",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
